<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/whisper_gray"
        app:rippleColor="@color/light_silver">

        <RelativeLayout
            android:id="@+id/root_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/image_card"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_alignParentStart="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/item_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/boarding_1" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/status_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Available"
                android:textColor="@color/black_cole"
                android:textStyle="bold"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPropertyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/image_card"
                android:layout_alignTop="@id/image_card"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="70dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Property name"
                android:fontFamily="@font/splinesans_bold"
                android:textStyle="bold"
                android:textColor="@color/black_cole"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_propertyAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/image_card"
                android:layout_below="@id/tvPropertyName"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="16dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Address"
                android:fontFamily="@font/splinesans_regular"
                android:textColor="@color/light_silver"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/ll_rooms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/image_card"
                android:layout_below="@id/tv_propertyAddress"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_rooms" />

                <TextView
                    android:id="@+id/rooms_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="16dp"
                    android:text="0 Rooms"
                    android:textColor="@color/black_cole"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_tenants" />

                <TextView
                    android:id="@+id/tenants_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="0 Tenants"
                    android:textColor="@color/black_cole"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivArrow"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/image_card"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/light_silver" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>