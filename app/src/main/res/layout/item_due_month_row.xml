<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/white"
    android:layout_marginBottom="8dp"
    android:padding="14dp">

    <!-- Month dot indicator -->
    <View
        android:id="@+id/viewMonthDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_initials_circle"
        android:layout_marginEnd="12dp"/>

    <!-- Month label + overdue tag -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMonthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="June 2026"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvMonthOverdueTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="#FFEBEE"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Overdue"
            android:textColor="#C62828"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Status badge -->
    <TextView
        android:id="@+id/tvMonthStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="Pending"
        android:textColor="#E65100"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp"/>

    <!-- Amount -->
    <TextView
        android:id="@+id/tvMonthAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0"
        android:textColor="#C62828"
        android:textSize="14sp"
        android:textStyle="bold"/>

</LinearLayout>