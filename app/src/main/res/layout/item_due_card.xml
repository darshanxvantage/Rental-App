<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP ROW: Photo + Info + Due Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivProfile"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_profile_nav"
                app:civ_border_width="2dp"
                app:civ_border_color="#E8EEFF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvTenantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tenant Name"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvRoomProperty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Room 1 • Property Name"
                    android:textColor="#888888"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- Due Amount -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDueAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textColor="#C62828"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Due"
                    android:textColor="#AAAAAA"
                    android:textSize="10sp"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- BILLING PERIOD: which month(s) this due covers, so the owner
             always knows exactly what they're being shown -->
        <TextView
            android:id="@+id/tvBillingPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Billing period: —"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <!-- STATS ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvMonthlyRent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Rent"
                    android:textColor="#AAAAAA"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvAdvance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Advance"
                    android:textColor="#AAAAAA"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvNextDueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#E65100"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Due Status"
                    android:textColor="#AAAAAA"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- DUE SOON ALERT (payment due within the reminder window) -->
        <LinearLayout
            android:id="@+id/llDueSoonAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFF3E0"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvDueSoonMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Rent due in 3 days — collect before due date"
                android:textColor="#E65100"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- PRORATED INFO (shown only for first month partial billing) -->
        <LinearLayout
            android:id="@+id/llProratedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFF8E1"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvProratedLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="First month: 6 days billing"
                android:textColor="#E65100"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvProratedAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹1200"
                android:textColor="#E65100"
                android:textSize="12sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- HISTORY HINT (2+ months pending) -->
        <LinearLayout
            android:id="@+id/llHistoryHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFF5F5"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvPendingMonthsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="2 months pending — tap to view"
                android:textColor="#C62828"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View ›"
                android:textColor="#C62828"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"/>

        <!-- ELECTRICITY ROW -->
        <LinearLayout
            android:id="@+id/rowElectricity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Electricity"
                android:textColor="#555555"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvElectricityType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Cost"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_badge_grey"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvElectricityCharge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- WATER ROW -->
        <LinearLayout
            android:id="@+id/rowWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Water"
                android:textColor="#555555"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvWaterType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Cost"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_badge_grey"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvWaterCharge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

        <!-- TOTAL ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Payable"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTotalPayable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="#2962FF"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- COLLECT BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCollect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Collect Rent"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            app:backgroundTint="#2563EB"
            app:cornerRadius="10dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>