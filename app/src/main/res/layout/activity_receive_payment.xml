                        <!-- Electricity meter reading — only shown when tenant's electricity billing mode is "metered" -->
                        <LinearLayout
                            android:id="@+id/ll_electricity_meter_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginVertical="8dp"
                                    android:text="@string/electricity_meter_reading"
                                    android:textColor="@color/text_dark_blue"
                                    android:textSize="16sp" />

                                <androidx.appcompat.widget.AppCompatEditText
                                    android:id="@+id/et_electricity_meter_reading"
                                    style="@style/EditText"
                                    android:background="@drawable/grey_border_background"
                                    android:hint="@string/enter_reading"
                                    android:inputType="numberDecimal"
                                    android:padding="16dp"
                                    android:textColorHint="@color/grey_hint" />

                                <TextView
                                    android:id="@+id/tv_last_electricity_reading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/grey_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginVertical="8dp"
                                    android:text="@string/electricity_units_charge"
                                    android:textColor="@color/text_dark_blue"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/tv_electricity_calculated_charge"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/grey_border_background"
                                    android:padding="16dp"
                                    android:textColor="@color/text_dark_blue" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Water meter reading — only shown when tenant's water billing mode is "metered" -->
                        <LinearLayout
                            android:id="@+id/ll_water_meter_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginVertical="8dp"
                                    android:text="@string/water_meter_reading"
                                    android:textColor="@color/text_dark_blue"
                                    android:textSize="16sp" />

                                <androidx.appcompat.widget.AppCompatEditText
                                    android:id="@+id/et_water_meter_reading"
                                    style="@style/EditText"
                                    android:background="@drawable/grey_border_background"
                                    android:hint="@string/enter_reading"
                                    android:inputType="numberDecimal"
                                    android:padding="16dp"
                                    android:textColorHint="@color/grey_hint" />

                                <TextView
                                    android:id="@+id/tv_last_water_reading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/grey_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginVertical="8dp"
                                    android:text="@string/water_units_charge"
                                    android:textColor="@color/text_dark_blue"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/tv_water_calculated_charge"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/grey_border_background"
                                    android:padding="16dp"
                                    android:textColor="@color/text_dark_blue" />
                            </LinearLayout>
                        </LinearLayout>
                        <!-- TOTAL PAYABLE SUMMARY — auto-updates as rent / meter readings change -->
                        <LinearLayout
                            android:id="@+id/ll_total_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/total_summary_background"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:id="@+id/ll_summary_rent_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/rent_amount"
                                    android:textColor="@color/grey_hint"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tv_summary_rent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="₹0"
                                    android:textColor="@color/text_dark_blue"
                                    android:textSize="14sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/ll_summary_electricity_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/electricity_units_charge"
                                    android:textColor="@color/grey_hint"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tv_summary_electricity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="₹0"
                                    android:textColor="@color/text_dark_blue"
                                    android:textSize="14sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/ll_summary_water_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/water_units_charge"
                                    android:textColor="@color/grey_hint"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tv_summary_water"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="₹0"
                                    android:textColor="@color/text_dark_blue"
                                    android:textSize="14sp" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="10dp"
                                android:background="#E0E0E0" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/total_payable"
                                    android:textColor="@color/text_dark_blue"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_total_payable"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="₹0"
                                    android:textColor="@android:color/black"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_payment_mode_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="8dp"
                            android:text="@string/payment_mode"
                            android:textColor="@color/text_dark_blue"
                            android:textSize="16sp" />

                        <RadioGroup
                            android:id="@+id/rg_payment_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/grey_border_background"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/_5sdp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rb_cash"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:checked="true"
                                android:gravity="center"
                                android:text="@string/cash"
                                android:textColor="@color/text_dark_blue"
                                android:theme="@style/RadioButtonStyle" />

                            <RadioButton
                                android:id="@+id/rb_upi"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:paddingVertical="@dimen/_10sdp"
                                android:text="@string/upi"
                                android:textColor="@color/text_dark_blue"
                                android:theme="@style/RadioButtonStyle" />
                            <RadioButton
                                android:id="@+id/rb_net_banking"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/net_banking"
                                android:textColor="@color/text_dark_blue"
                                android:theme="@style/RadioButtonStyle" />
                        </RadioGroup>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/note"
                            android:textColor="@color/text_dark_blue"
                            android:textSize="16sp" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/et_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textSize="@dimen/et_text"
                            android:imeOptions="actionNext"
                            android:fontFamily="@font/outfit_regular"
                            android:background="@drawable/grey_border_background"
                            android:hint="@string/enter_note"
                            android:minLines="4"
                            android:padding="@dimen/space8"
                            android:gravity="start"
                            android:textColorHint="@color/grey_hint" />


                        <Button
                            android:id="@+id/btn_rcv_payment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="8dp"
                            android:backgroundTint="@android:color/black"
                            android:padding="10dp"
                            android:text="@string/payment_received"
                            android:textColor="@android:color/white" />




                    </LinearLayout>


                </androidx.cardview.widget.CardView>


            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</layout>