<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">

    <!-- BOOLEAN field -> label + switch on one row -->
    <LinearLayout
        android:id="@+id/rowBooleanField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvFieldLabelBoolean"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Field label"
            android:textColor="#111111"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchField"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- TEXT / NUMBER / TEXTAREA field -> TextInputLayout -->
    <com.google.android.material.textfield.TextInputLayout style="@style/Wizard.TextInputLayout"
        android:id="@+id/layoutTextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Field label"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText android:textColor="#111111" android:textColorHint="#9E9E9E"
            android:id="@+id/etField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- SELECT / MULTISELECT field -> label + chip options -->
    <LinearLayout
        android:id="@+id/rowChoiceField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvFieldLabelChoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Field label"
            android:textColor="#111111"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>