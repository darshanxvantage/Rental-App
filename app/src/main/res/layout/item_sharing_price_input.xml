<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#ECECEC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSharingTypeInputLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sharing Type"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnRemoveSharingRow"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_back"
                android:rotation="45"
                android:contentDescription="Remove this row" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sharingTypeChipGroupRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRowSingle"
                style="@style/Wizard.ChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="Single" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRowDouble"
                style="@style/Wizard.ChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="Double" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRowTriple"
                style="@style/Wizard.ChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="Triple" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRowFourSharing"
                style="@style/Wizard.ChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="4 Sharing" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRowDormitory"
                style="@style/Wizard.ChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="Dormitory" />

        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout style="@style/Wizard.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Price/mo *">
                <com.google.android.material.textfield.TextInputEditText android:textColor="#111111" android:textColorHint="#9E9E9E"
                    android:id="@+id/etRowPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/Wizard.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Deposit">
                <com.google.android.material.textfield.TextInputEditText android:textColor="#111111" android:textColorHint="#9E9E9E"
                    android:id="@+id/etRowDeposit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout style="@style/Wizard.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Maintenance">
                <com.google.android.material.textfield.TextInputEditText android:textColor="#111111" android:textColorHint="#9E9E9E"
                    android:id="@+id/etRowMaintenance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/Wizard.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Available Beds *">
                <com.google.android.material.textfield.TextInputEditText android:textColor="#111111" android:textColorHint="#9E9E9E"
                    android:id="@+id/etRowAvailableBeds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>