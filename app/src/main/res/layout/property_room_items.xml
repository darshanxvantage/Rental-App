<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@color/whisper_gray">

            <!-- Occupied/Vacant -->

            <TextView
                android:id="@+id/tv_occupied"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_margin="8dp"
                android:background="@drawable/status_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Occupied"
                android:textColor="@color/black_cole"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Room Number -->

            <TextView
                android:id="@+id/tv_room_number"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="101"
                android:textColor="@android:color/black"
                android:textSize="40sp"
                android:textStyle="bold" />

            <!-- Button -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_tenant"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:layout_margin="6dp"
                android:text="Add Tenant"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="@color/black_cole"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_click_circle"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</layout>