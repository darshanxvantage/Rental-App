<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F5F9">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:fitsSystemWindows="true"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fitsSystemWindows="true"
                app:contentScrim="@color/primary_blue"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:titleEnabled="false">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/tenant_hero_gradient"
                    app:layout_collapseMode="parallax" />

                <View
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="-50dp"
                    android:layout_marginEnd="-50dp"
                    android:background="@drawable/tenant_deco_circle_large"
                    android:alpha="0.12"
                    app:layout_collapseMode="parallax" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="start|bottom"
                    android:layout_marginStart="-30dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/tenant_deco_circle_large"
                    android:alpha="0.08"
                    app:layout_collapseMode="parallax" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="48dp"
                    android:paddingBottom="24dp"
                    app:layout_collapseMode="parallax">

                    <FrameLayout
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:layout_gravity="center">

                        <!-- Outer Ring -->
                        <View
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:background="@drawable/tenant_avatar_ring"
                            android:alpha="0.6"/>

                        <!-- Tenant Photo -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivTenant"
                            android:layout_width="105dp"
                            android:layout_height="105dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:elevation="10dp"
                            android:padding="2dp"
                            android:background="@android:color/white"
                            app:shapeAppearanceOverlay="@style/CircleImage"/>

                    </FrameLayout>

                    <!-- Tenant Name -->
                    <TextView
                        android:id="@+id/tvTenantName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/splinesans_bold"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="3"
                        android:shadowRadius="8" />

                    <!--
                        FIX: Status badge mein SIRF ek dot hai (View) aur ek TextView.
                        Kotlin mein "● ACTIVE TENANT" mat likho — sirf "ACTIVE TENANT" likho.
                        Dot View alag hai — isliye double dot aa raha tha.
                    -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/tenant_status_badge"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp">

                        <!-- YEH ANIMATED DOT HAI — TextView mein "●" mat add karo -->
                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/tenant_dot_pulse"
                            android:layout_marginEnd="6dp" />

                        <!-- FIXED: Sirf text — no "●" symbol yahan -->
                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/splinesans_semibold"
                            android:text="ACTIVE TENANT"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:letterSpacing="0.08" />

                    </LinearLayout>

                </LinearLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:layout_collapseMode="pin"
                    app:navigationIcon="@drawable/ic_back"
                    app:navigationIconTint="@android:color/black"/>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="16dp">

                <!-- PROPERTY INFORMATION CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/tenant_icon_bg_blue"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/icon_home"
                                    android:textSize="18sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:fontFamily="@font/splinesans_semibold"
                                android:text="Property Information"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9"
                            android:layout_marginBottom="14dp" />

                        <!-- Property Name Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_pin"
                                android:textSize="15sp"
                                android:layout_marginEnd="10dp" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PROPERTY NAME"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp"
                                    android:letterSpacing="0.06" />
                                <TextView
                                    android:id="@+id/tvProperty"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#1E293B"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Room Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_door"
                                android:textSize="15sp"
                                android:layout_marginEnd="10dp" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ROOM NUMBER"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp"
                                    android:letterSpacing="0.06" />
                                <TextView
                                    android:id="@+id/tvRoom"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#1E293B"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Phone Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_phone"
                                android:textSize="15sp"
                                android:layout_marginEnd="10dp" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PHONE NUMBER"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp"
                                    android:letterSpacing="0.06" />
                                <TextView
                                    android:id="@+id/tvPhone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#1E293B"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- FINANCIAL CARDS ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="6dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/tenant_rent_gradient"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <LinearLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/tenant_white_circle"
                                android:gravity="center"
                                android:layout_marginBottom="8dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/icon_money"
                                    android:textSize="20sp" />
                            </LinearLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MONTHLY RENT"
                                android:textColor="#FFFFFFCC"
                                android:textSize="10sp"
                                android:letterSpacing="0.08" />
                            <TextView
                                android:id="@+id/tvRent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="6dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/tenant_deposit_gradient"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <LinearLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/tenant_white_circle"
                                android:gravity="center"
                                android:layout_marginBottom="8dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/icon_lock"
                                    android:textSize="20sp" />
                            </LinearLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DEPOSIT"
                                android:textColor="#FFFFFFCC"
                                android:textSize="10sp"
                                android:letterSpacing="0.08" />
                            <TextView
                                android:id="@+id/tvDeposit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- UTILITY AND RENTAL DETAILS CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">
                            <LinearLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/tenant_icon_bg_amber"
                                android:gravity="center">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/icon_lightning" android:textSize="18sp" />
                            </LinearLayout>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:fontFamily="@font/splinesans_semibold"
                                android:text="Utility &amp; Rental Details"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginBottom="14dp" />

                        <!-- Check In Date -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                            <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/tenant_util_icon_bg" android:gravity="center" android:layout_marginEnd="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/icon_calendar" android:textSize="14sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHECK IN DATE" android:textColor="#94A3B8" android:textSize="11sp" android:letterSpacing="0.06" />
                                <TextView android:id="@+id/tvCheckInDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1E293B" android:textSize="14sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Rent Start Date -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                            <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/tenant_util_icon_bg" android:gravity="center" android:layout_marginEnd="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/icon_calendar2" android:textSize="14sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RENT START DATE" android:textColor="#94A3B8" android:textSize="11sp" android:letterSpacing="0.06" />
                                <TextView android:id="@+id/tvRentStartDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1E293B" android:textSize="14sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Electricity -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                            <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/tenant_util_icon_bg" android:gravity="center" android:layout_marginEnd="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/icon_bulb" android:textSize="14sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FIXED ELECTRICITY" android:textColor="#94A3B8" android:textSize="11sp" android:letterSpacing="0.06" />
                                <TextView android:id="@+id/tvElectricity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1E293B" android:textSize="14sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Water Bill -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                            <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/tenant_util_icon_bg" android:gravity="center" android:layout_marginEnd="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/icon_water" android:textSize="14sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FIXED WATER BILL" android:textColor="#94A3B8" android:textSize="11sp" android:letterSpacing="0.06" />
                                <TextView android:id="@+id/tvWater" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1E293B" android:textSize="14sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Unit Costs -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="14dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="8dp">
                                <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/tenant_util_icon_bg" android:gravity="center" android:layout_marginEnd="10dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/icon_lightning" android:textSize="14sp" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ELEC/UNIT" android:textColor="#94A3B8" android:textSize="10sp" android:letterSpacing="0.05" />
                                    <TextView android:id="@+id/tvCostPerUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1E293B" android:textSize="14sp" android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="8dp">
                                <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/tenant_util_icon_bg" android:gravity="center" android:layout_marginEnd="10dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/icon_water" android:textSize="14sp" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WATER/UNIT" android:textColor="#94A3B8" android:textSize="10sp" android:letterSpacing="0.05" />
                                    <TextView android:id="@+id/tvWaterUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1E293B" android:textSize="14sp" android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>